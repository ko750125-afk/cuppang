rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // [기존] 기본 유저 접근 규칙
    match /users {
      allow read: if true;
    }

    // [기존] 유저 데이터 보호 규칙
    match /users/{userId} {
      // 1. 로그인한 사용자는 데이터 연동(공유 ID)을 위해 모든 경로에 접근 가능하도록 완화
      allow read, write: if request.auth != null;
      
      // 2. 비로그인 사용자(기기 ID/공유 ID)는 해당 ID를 알고 있을 때만 접근 가능
      allow read, write: if request.auth == null;

      match /{allPaths=**} {
        allow read, write: if request.auth != null;
        allow read, write: if request.auth == null;
      }
    }
    
    // [기존] 정산 수령 확인 메타데이터 보호
    match /users/{userId}/meta/{document=**} {
       allow read, write: if request.auth != null;
       allow read, write: if request.auth == null;
    }

    // [기존] Vibe-coding.wiki 앱을 위한 규칙
    match /vibecoding_entries/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // ✨ [기존] 스타일리스트 앱 - 회원 데이터 규칙
    match /stylist_users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ✨ [기존] 스타일리스트 앱 - 이미지 정보 메타데이터 규칙
    match /stylist_images/{docId} {
      allow read, write: if request.auth != null;
    }

    // ✨ [기존] 스타일리스트 앱 - 스타일 분석 결과 규칙
    match /stylist_results/{docId} {
      allow read, write: if request.auth != null;
    }

    // 🚚 [신규] Cuppang 정산 앱 - 실적 데이터 규칙
    match /cuppang_records/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 🚚 [신규] Cuppang 정산 앱 - 설정 데이터 규칙
    match /cuppang_settings/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    
  }
}
